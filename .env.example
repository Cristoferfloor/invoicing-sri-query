SRI_QUERY_PORT=3005

# Base "invoicing" de Infrastructure/ (usuario core)
SRI_QUERY_MONGO_URL=mongodb://core:CLAVE@mongo:27017/invoicing?authSource=admin&replicaSet=rs0

# Token para los endpoints /v1 (header X-Token-Admin)
SRI_QUERY_ADMIN_TOKEN=

SRI_TIMEOUT_MS=60000

# Modo automatico: consulta los ENVIADO sin Postman
SRI_QUERY_AUTO=true
SRI_QUERY_PULSE_MS=3000
# Segundos entre consultas de autorizacion (la ultima se repite)
SRI_QUERY_WAITS_SEC=3,10,30,60,120,300,600,1800
